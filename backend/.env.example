# LoanWise Backend Environment Configuration Example
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# Server port
PORT=5001

# Resend API Key (obtain from https://resend.com/api-keys)
# NEVER commit your real API key to Git!
RESEND_API_KEY=your_resend_api_key_here

# Verified Sender Email (default for test accounts is onboarding@resend.dev)
EMAIL_FROM=LoanWise <onboarding@resend.dev>

# Secret key used for signing JWT authentication tokens
JWT_SECRET=change_this_to_a_long_random_secret_string

# OTP configuration
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60

# Environment mode (development / production / test)
NODE_ENV=development

# Vercel KV / Upstash Redis (Automatically provided by Vercel when connected in dashboard)
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# Or Upstash Redis:
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
